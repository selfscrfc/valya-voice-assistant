#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
assistant_app="$HOME/Applications/Valya.app"
assistant_binary="$assistant_app/Contents/MacOS/Wchat"
if [ ! -x "$assistant_binary" ] || [ "$ROOT/native/Wchat.swift" -nt "$assistant_binary" ] || [ "$ROOT/scripts/build_desktop.py" -nt "$assistant_binary" ]; then
    "$ROOT/.venv/bin/python" "$ROOT/scripts/build_desktop.py"
    "$ROOT/.venv/bin/python" "$ROOT/scripts/install_desktop.py"
fi
open "$assistant_app" --args "$@"
